{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MiguelDuval/Mozart/schemas/mozart-dataset-manifest-v1.schema.json",
  "title": "Mozart Dataset Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "license_policy",
    "project_vocabulary_id",
    "sources",
    "splits",
    "normalization",
    "examples"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["template", "audited", "release"] },
    "license_policy": { "const": "commercial-compatible-only" },
    "project_vocabulary_id": { "const": "mozart-midi-events-v1" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "name", "locator", "revision", "license", "files", "provenance"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "license": {
            "type": "object",
            "required": ["spdx_id", "commercial_use", "redistribution", "attribution"],
            "properties": {
              "spdx_id": { "type": "string", "minLength": 1 },
              "commercial_use": { "enum": ["allowed", "requires-review", "prohibited"] },
              "redistribution": { "enum": ["allowed", "requires-review", "prohibited"] },
              "attribution": { "enum": ["required", "not-required", "requires-review"] },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256", "size_bytes"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$|^REPLACE$" },
                "size_bytes": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "provenance": {
            "type": "object",
            "required": ["provider", "acquisition_date", "rights_evidence"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "acquisition_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$|^YYYY-MM-DD$" },
              "rights_evidence": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "splits": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "additionalProperties": false,
      "properties": {
        "train": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 }
      }
    },
    "normalization": {
      "type": "object",
      "required": [
        "revision",
        "ticks_per_quarter_policy",
        "tempo_policy",
        "meter_policy",
        "channel_policy",
        "note_policy",
        "velocity_policy",
        "duration_policy",
        "time_shift_policy",
        "controller_policy",
        "deduplication",
        "max_events_per_example"
      ],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "ticks_per_quarter_policy": { "type": "string", "minLength": 1 },
        "tempo_policy": { "type": "string", "minLength": 1 },
        "meter_policy": { "type": "string", "minLength": 1 },
        "channel_policy": { "type": "string", "minLength": 1 },
        "note_policy": { "type": "string", "minLength": 1 },
        "velocity_policy": { "type": "string", "minLength": 1 },
        "duration_policy": { "type": "string", "minLength": 1 },
        "time_shift_policy": { "type": "string", "minLength": 1 },
        "controller_policy": { "type": "string", "minLength": 1 },
        "deduplication": { "type": "string", "minLength": 1 },
        "max_events_per_example": { "type": "integer", "minimum": 1, "maximum": 4096 }
      },
      "additionalProperties": false
    },
    "examples": {
      "type": "object",
      "required": ["min_bars", "max_bars", "context_length_tokens", "max_generated_tokens"],
      "properties": {
        "min_bars": { "type": "integer", "minimum": 1, "maximum": 16 },
        "max_bars": { "type": "integer", "minimum": 1, "maximum": 16 },
        "context_length_tokens": { "type": ["integer", "string"] },
        "max_generated_tokens": { "type": ["integer", "string"] }
      },
      "additionalProperties": false
    },
    "checksums": {
      "type": "object",
      "properties": {
        "manifest_sha256": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
